# Shared Dockerfile for all backend microservices.
# Each service sets SERVICE_DIR as a build arg to pick its source.
# Bun runs inside the container — no host Bun needed.
#
# Pattern: deps stage caches `bun install` (only re-runs when manifests change).
# Source is copied into the image so it runs consistently without host mounts.

# syntax=docker/dockerfile:1.4
FROM oven/bun:1.3.14 AS base
WORKDIR /app

# ─── deps stage — cached unless package.json/bun.lock change ───────────────
FROM base AS deps

# Copy only manifests — this layer is cached across code changes
COPY package.json bun.lock bunfig.toml ./
COPY packages/config/package.json        ./packages/config/
COPY packages/contracts/package.json     ./packages/contracts/
COPY packages/cost-tracker/package.json  ./packages/cost-tracker/
COPY packages/database/package.json      ./packages/database/
COPY packages/gemini-client/package.json ./packages/gemini-client/
COPY packages/deepseek-client/package.json ./packages/deepseek-client/
COPY packages/llm-provider/package.json  ./packages/llm-provider/
COPY packages/remotion-templates/package.json ./packages/remotion-templates/
COPY packages/server/package.json        ./packages/server/
COPY packages/workflow-engine/package.json ./packages/workflow-engine/
COPY services/api-gateway/package.json          ./services/api-gateway/
COPY services/embedding-service/package.json    ./services/embedding-service/
COPY services/image-service/package.json        ./services/image-service/
COPY services/research-service/package.json     ./services/research-service/
COPY services/story-service/package.json        ./services/story-service/
COPY services/voice-service/package.json        ./services/voice-service/
COPY services/video-service/package.json        ./services/video-service/
COPY services/workflow-service/package.json     ./services/workflow-service/
COPY web-frontend/package.json          ./web-frontend/

# Install with BuildKit cache mount — bun's download cache persists across builds
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# ─── runtime stage — used by Docker Compose ────────────────────────────────
FROM base AS development

# System dependencies:
# - ffmpeg/ffprobe: audio/video processing (voice-service and video-service)
# - zip: export package compression (voice-service)
# - ca-certificates: TLS for outbound API calls
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    zip \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Root dependencies and config are copied separately for layer reuse.
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bunfig.toml tsconfig.json ./

# Pre-cache the Kokoro TTS model so voice-service doesn't download it at
# runtime. A runtime download failure triggers the paid Gemini TTS fallback
# (~$0.03/run). Only runs for voice-service to avoid wasting build time.
# The script and its constants dependency are copied before the full source so
# unrelated source changes do not invalidate the model cache layer.
ARG SERVICE_DIR
COPY services/voice-service/scripts/precache-kokoro.ts ./services/voice-service/scripts/precache-kokoro.ts
COPY services/voice-service/src/constants.ts ./services/voice-service/src/constants.ts
RUN if [ "$SERVICE_DIR" = "voice-service" ]; then \
      bun run services/voice-service/scripts/precache-kokoro.ts; \
    fi

COPY packages ./packages
COPY services ./services
COPY video-templates ./video-templates

ENV SERVICE_DIR=${SERVICE_DIR}

ARG PORT=3000
ENV PORT=${PORT}

CMD ["sh", "-c", "bun run services/${SERVICE_DIR}/src/index.ts"]
