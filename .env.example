# Clipatro — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# === Provider credentials ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=projects/your_project_id

# === LLM provider selection ===
# Which provider to use for text generation (story, research structuring, scene planning).
# "gemini" (default) or "deepseek".
# Image generation and research grounding always use Gemini regardless of this setting.
# LLM_PROVIDER=gemini

# === DeepSeek (alternative text generation provider) ===
# Get an API key at https://platform.deepseek.com
# Only needed if LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# === Chatterbox TTS (self-hosted, free, OpenAI-compatible) ===
# Runs as a separate service: https://github.com/travisvn/chatterbox-tts-api
# Only needed if TTS_PROVIDER=chatterbox (or provider="chatterbox" in /synthesize)
# CHATTERBOX_API_BASE=http://localhost:4123
# CHATTERBOX_API_KEY=  # optional bearer token for remote instances
# CHATTERBOX_MODEL=chatterbox-tts
# CHATTERBOX_VOICE=default

# === TTS provider selection ===
# Which TTS provider the workflow uses for voice_generation steps.
# "auto" (default)       — Kokoro (local, free), falls back to Gemini TTS on failure.
# "kokoro"               — Kokoro only (local, free). No fallback.
# "chatterbox"           — Chatterbox TTS API (self-hosted, free). Requires CHATTERBOX_API_BASE.
# "gemini"               — Gemini TTS only (paid, ~$0.01/segment).
# TTS_PROVIDER=auto

# === Dry-run mode (saves API costs during testing) ===
# When true, ALL paid provider calls (Gemini, DeepSeek, fal.ai, Gemini TTS)
# return placeholder data instead of hitting real APIs.
# Free/local providers (Kokoro TTS, local embeddings) still run normally.
# Placeholder media is loaded from media/dry-run/.
# Set to "true" or "1" to enable.
# DRY_RUN=false
# Legacy: GEMINI_DRY_RUN=false (still respected, implies DRY_RUN)

# === Database (Neon serverless PostgreSQL) ===
# Create a free project at https://neon.tech and copy the connection string.
# The URL includes ?sslmode=require for TLS to Neon's edge endpoints.
# In Docker: set this in .env — docker-compose.yml reads it via env_file.
# In local dev: set this in .env or export it in your shell.
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/clipatro?sslmode=require

# === Cost tracking budgets (USD) ===
# Override the defaults if needed.
# COST_BUDGET_PER_RUN=2.0
# COST_BUDGET_PER_DAY=10.0
# COST_BUDGET_GLOBAL=100.0

# === Service URLs ===
# In Docker: use container names (e.g. http://story-service:3001)
# In local dev (no Docker): use localhost (e.g. http://localhost:3001)
# These are set automatically in docker-compose.yml. Only set them here
# if you need to override for local development.
# STORY_SERVICE_URL=http://localhost:3001
# RESEARCH_SERVICE_URL=http://localhost:3002
# IMAGE_SERVICE_URL=http://localhost:3003
# VOICE_SERVICE_URL=http://localhost:3004
# EMBEDDING_SERVICE_URL=http://localhost:3005
# WORKFLOW_SERVICE_URL=http://localhost:3006

# === Gameplay videos ===
# Path to copyright-free gameplay videos for background footage.
# In Docker, this is set to /app/media/gameplay (mounted read-only).
# GAMEPLAY_VIDEO_PATH=./media/gameplay

# === Optional providers (not needed for MVP) ===
# BFL_API_KEY=your_bfl_flux_key
# ELEVENLABS_API_KEY=your_elevenlabs_key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === Runware (low-cost image generation, FLUX.2 [klein] 9B) ===
# Get an API key at https://runware.ai
# Used by spike S10 to test FLUX.2 [klein] 9B character consistency.
# RUNWARE_API_KEY=your_runware_api_key_here

# === fal.ai (image generation, FLUX.2 [klein] 9B edit with reference images) ===
# Get $20 free credits on signup at https://fal.ai
# Create a key at https://fal.ai/dashboard/keys
# Required when IMAGE_PROVIDER=fal (default).
# FAL_KEY=your_fal_api_key_here

# === Image generation provider selection ===
# "fal" (default) — uses fal.ai FLUX.2 [klein] 9B for character scenes, 4B for non-character.
#                    ~$0.015/image with 512x512 optimized inputs (78% savings vs Gemini).
# "gemini"         — uses direct Gemini API (Gemini 3.1 Flash Image / Flash Lite Image).
#                    $0.067/image for character scenes, $0.034 for non-character.
# IMAGE_PROVIDER=fal
# Override individual models (optional):
# IMAGE_MODEL_CHARACTER=fal-ai/flux-2/klein/9b/edit
# IMAGE_MODEL_NON_CHARACTER=fal-ai/flux-2/klein/4b/edit
# To switch to Gemini Lite via fal.ai later:
# IMAGE_MODEL_CHARACTER=fal-ai/nano-banana-2/edit

# === Ably (realtime pub/sub for live pipeline updates) ===
# ABLY_ROOT_KEY=your_ably_root_key (server-side publishing)
# ABLY_SUBSCRIBE_KEY=your_ably_subscribe_key (frontend, publish not allowed)
